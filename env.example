# --- PocketBase ---
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090
# Optional: private URL the server uses (skips any proxy/tunnel)
# POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=your_secure_password

# --- Sessions ---
# Signs the login cookie. Falls back to NEXTAUTH_SECRET for older deployments.
SESSION_SECRET=generate_with_openssl_rand_base64_32

# --- Site ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Task Dashboard
# NEXT_PUBLIC_SITE_SHORT_NAME=Tasks
# NEXT_PUBLIC_SITE_TAGLINE=Pitch in. Make things. Show your work.
# NEXT_PUBLIC_SITE_DESCRIPTION=A community workspace where people come together to learn, share, and create.
# NEXT_PUBLIC_LOGO_PATH=/logo.webp

# --- Admins (comma-separated). Discord "Zone Leader" role also grants admin. ---
# ADMIN_EMAILS=you@example.com
# ADMIN_DISCORD_IDS=123456789012345678
# DISCORD_ADMIN_ROLES=Zone Leader

# --- Optional: require a code to create a password account (server-checked) ---
# SIGNUP_INVITE_CODE=

# --- Optional: Discord (login + announcements). Leave blank to disable. ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
